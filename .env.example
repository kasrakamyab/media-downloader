# Copy to .env. Never commit .env.
BOT_TOKEN=123456:replace-with-botfather-token
ADMIN_IDS=            # comma-separated Telegram user ids: /stats access and down/up alerts

# Gateway
MODE=polling          # polling on your laptop, webhook on the server
WEBHOOK_URL=          # https://bot.example.com/webhook (webhook mode only)
WEBHOOK_SECRET=       # random string; Telegram sends it back in a header
WEBHOOK_PORT=8080     # also serves /health in polling mode
MAX_ACTIVE_JOBS=2
HOURLY_LIMIT=20
QUALITY_CHOICE_TIMEOUT=60   # seconds before the best quality under the cap is picked for the user
PROBE_CACHE_TTL=600

# Workers
REDIS_URL=redis://localhost:6379/0   # compose overrides this to redis://redis:6379/0
MAX_FILE_MB=48        # Bot API cap is 50 MB; raise to 500 with the self-hosted Bot API server
JOB_DIR=/tmp/jobs
EXTRACT_TIMEOUT=30
DOWNLOAD_TIMEOUT=120
JOB_TTL=600
MIN_FREE_GB=1
CACHE_TTL_DAYS=30
DOWNLOAD_RATE_LIMIT=  # e.g. 5M to cap each download at 5 MB/s
HEALTH_PORT=8081      # worker /health; 0 disables
# WORKER_CONCURRENCY is set per service in docker-compose.yml (YT_CONCURRENCY etc.)

# Resilience
BREAKER_THRESHOLD=5   # transient failures ...
BREAKER_WINDOW=600    # ... within this many seconds ...
BREAKER_OPEN_FOR=900  # ... open the platform's breaker for this long
TRANSIENT_RETRIES=1
RETRY_BACKOFF=2
ALERT_AFTER_OPEN_S=1800

# Self-hosted Bot API server (docker compose --profile bigfiles up). Get the id/hash from
# https://my.telegram.org -> API development tools. Leave TELEGRAM_API_URL empty otherwise.
TELEGRAM_API_URL=     # http://telegram-bot-api:8081
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional cookies (Netscape format) mounted from ./secrets, e.g. /secrets/youtube.txt
YT_COOKIES_FILE=
IG_COOKIES_FILE=
PIN_COOKIES_FILE=

LOG_LEVEL=INFO
LOG_JSON=false        # true on the server so the log shipper gets structured lines
