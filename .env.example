# Copy to .env and never commit it.
# Docker's env_file is NOT shell syntax: keep comments on their own lines and leave a key
# empty as `KEY=` (no trailing comment) when you don't use it.

BOT_TOKEN=123456:replace-with-botfather-token
# Comma-separated Telegram user ids: /stats access and down/up/login alerts.
ADMIN_IDS=

# ---- Gateway ------------------------------------------------------------------------
# polling on your laptop, webhook on the server
MODE=polling
# Webhook mode only, e.g. https://bot.example.com/webhook and a random secret.
WEBHOOK_URL=
WEBHOOK_SECRET=
# Also serves /health in polling mode.
WEBHOOK_PORT=8080
MAX_ACTIVE_JOBS=2
HOURLY_LIMIT=20
# Per group chat (on top of the per-user limits): jobs in flight and requests per hour.
# Keep MAX_ACTIVE_PER_CHAT below each worker's concurrency so one group can't hold every slot.
MAX_ACTIVE_PER_CHAT=2
GROUP_HOURLY_LIMIT=60
# Seconds before the best quality under the cap is picked for the user.
QUALITY_CHOICE_TIMEOUT=60
# Groups: auto-download is on by default where the bot can see messages; the same link
# posted again within this many seconds is skipped (two people sharing the same video).
AUTO_DEDUPE_SECONDS=120
# Caption under delivered media: full (title, date/duration/views/likes, channel, format,
# expandable description), short (title linked to the source only), off. Group admins can
# switch captions off per group in /settings.
CAPTIONS=full
# Progress as a reaction on the user's message (👀 while working, 👍 done, 👎 failed) instead
# of a "Working on it…" message. Falls back to the message where reactions aren't allowed.
USE_REACTIONS=true
PROBE_CACHE_TTL=600

# ---- Network ------------------------------------------------------------------------
# Telegram blocked where the bot runs? Route Bot API calls through a proxy:
#   TELEGRAM_PROXY=http://host.docker.internal:10808   or   socks5://host.docker.internal:10808
TELEGRAM_PROXY=
# Proxy for yt-dlp / gallery-dl / short-link resolution (independent of the one above).
# The pot-provider sidecar uses it too.
DOWNLOAD_PROXY=
# YouTube PO-token sidecar (docker-compose.yml starts it). Compose sets this for the
# YouTube worker; set it here only when running without Docker (http://localhost:4416).
POT_PROVIDER_URL=
# Self-hosted Bot API server (docker compose --profile bigfiles up). Get the id/hash from
# https://my.telegram.org -> API development tools. Leave TELEGRAM_API_URL empty otherwise.
#   TELEGRAM_API_URL=http://telegram-bot-api:8081
TELEGRAM_API_URL=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Workers ------------------------------------------------------------------------
# docker-compose.yml overrides this to redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
# Bot API cap is 50 MB; raise to 500 with the self-hosted Bot API server.
MAX_FILE_MB=48
JOB_DIR=/tmp/jobs
EXTRACT_TIMEOUT=30
DOWNLOAD_TIMEOUT=120
JOB_TTL=600
MIN_FREE_GB=1
CACHE_TTL_DAYS=30
# e.g. 5M to cap each download at 5 MB/s
DOWNLOAD_RATE_LIMIT=
# Telegram upload request timeout = max(60, size_mb * UPLOAD_SECONDS_PER_MB), capped at
# UPLOAD_TIMEOUT. The defaults allow ~0.13 MB/s; lower the per-MB value on a fast server.
UPLOAD_TIMEOUT=600
UPLOAD_SECONDS_PER_MB=8
# Worker /health port; 0 disables. WORKER_CONCURRENCY is set per service in docker-compose.yml
# (YT_CONCURRENCY=2, IG_CONCURRENCY=4, PIN_CONCURRENCY=4). YouTube runs deno per job for
# YouTube's JS challenges and needs ~1.5 GB (mem_limit in compose); raising YT_CONCURRENCY
# without raising the limit gets deno OOM-killed and jobs fail with "format not available".
HEALTH_PORT=8081

# ---- Resilience ---------------------------------------------------------------------
# BREAKER_THRESHOLD transient failures within BREAKER_WINDOW seconds open the platform's
# breaker for BREAKER_OPEN_FOR seconds.
BREAKER_THRESHOLD=5
BREAKER_WINDOW=600
BREAKER_OPEN_FOR=900
TRANSIENT_RETRIES=1
RETRY_BACKOFF=2
ALERT_AFTER_OPEN_S=1800

# ---- Cookies (Netscape format), mounted from ./secrets --------------------------------
# Instagram needs one for almost everything; YouTube only when it shows a sign-in wall.
#   IG_COOKIES_FILE=/secrets/instagram.txt
YT_COOKIES_FILE=
IG_COOKIES_FILE=
PIN_COOKIES_FILE=

# ---- Logging ------------------------------------------------------------------------
LOG_LEVEL=INFO
# true on the server so the log shipper gets structured lines
LOG_JSON=false
