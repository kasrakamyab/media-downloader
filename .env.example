# Copy to .env. Never commit .env.
BOT_TOKEN=123456:replace-with-botfather-token
ADMIN_IDS=            # comma-separated Telegram user ids allowed to run /stats

# Gateway
MODE=polling          # polling on your Mac, webhook on the server
WEBHOOK_URL=          # https://bot.example.com/webhook (webhook mode only)
WEBHOOK_SECRET=       # random string; Telegram sends it back in a header
WEBHOOK_PORT=8080
MAX_ACTIVE_JOBS=2
HOURLY_LIMIT=20

# Workers
REDIS_URL=redis://localhost:6379/0   # compose overrides this to redis://redis:6379/0
MAX_FILE_MB=48        # Bot API cap is 50 MB; raise to 500 with a self-hosted Bot API server
JOB_DIR=/tmp/jobs
EXTRACT_TIMEOUT=30
DOWNLOAD_TIMEOUT=120
JOB_TTL=600
MIN_FREE_GB=1
CACHE_TTL_DAYS=30
DOWNLOAD_RATE_LIMIT=  # e.g. 5M to cap each download at 5 MB/s
TELEGRAM_API_URL=     # http://telegram-bot-api:8081 when self-hosting the Bot API server

# Optional cookies (Netscape format) mounted from ./secrets
YT_COOKIES_FILE=
IG_COOKIES_FILE=
PIN_COOKIES_FILE=

LOG_LEVEL=INFO
LOG_JSON=false
